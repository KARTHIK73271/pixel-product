# Copy to .env and adjust. Every value is optional for local development.

# API port (the Vite dev server proxies /api to it)
PORT=3001

# Database
# - Leave DATABASE_URL empty to use embedded PostgreSQL (PGlite) on disk.
# - Set it to use an external PostgreSQL 14+ server instead, e.g.
#   DATABASE_URL=postgres://exam_owner:secret@localhost:5432/exam_section
#   The connecting role must own the schema; migrations create the least-privileged
#   `exam_app` role and grant it to the connecting role so requests can SET ROLE into it.
DATABASE_URL=

# Embedded database directory. Defaults to ./.data/pglite, or to the local app-data folder
# when the project sits inside a OneDrive/Dropbox/iCloud/Google Drive synced folder.
# PGLITE_DATA_DIR=

# Session lifetime (hours) and cookie security. COOKIE_SECURE defaults to true in production.
SESSION_TTL_HOURS=12
# COOKIE_SECURE=true

# Show the demo-account panel on the login page. Defaults to on in development and is
# always off when NODE_ENV=production.
# DEMO_MODE=true

# NODE_ENV=production   # `npm start` sets this; serves the built SPA from ./dist
